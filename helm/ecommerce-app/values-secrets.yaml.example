# Copie ce fichier en "values-secrets.yaml" et remplace <AWS_ACCOUNT_ID>
# par ton vrai ID de compte (visible avec `aws sts get-caller-identity --query Account --output text`).
#
# "values-secrets.yaml" est volontairement exclu du repo Git (voir .gitignore),
# pour ne jamais publier ton ID de compte AWS ni tes URLs de registre privées.

frontend:
  image:
    repository: <AWS_ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/orchestration-eks/frontend
    tag: latest

api-gateway:
  image:
    repository: <AWS_ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/orchestration-eks/api-gateway
    tag: latest

user-service:
  image:
    repository: <AWS_ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/orchestration-eks/user-service
    tag: latest

product-service:
  image:
    repository: <AWS_ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/orchestration-eks/product-service
    tag: latest

order-service:
  image:
    repository: <AWS_ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/orchestration-eks/order-service
    tag: latest

notification-service:
  image:
    repository: <AWS_ACCOUNT_ID>.dkr.ecr.eu-west-3.amazonaws.com/orchestration-eks/notification-service
    tag: latest

frontend:
  ingress:
    annotations:
      alb.ingress.kubernetes.io/certificate-arn: "arn:aws:acm:eu-west-3:<AWS_ACCOUNT_ID>:certificate/xxxxxxxx"